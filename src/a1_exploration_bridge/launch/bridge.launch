<launch>
  <arg name="state_source" default="gazebo_model_states"/>
  <arg name="model_name" default="a1_gazebo"/>
  <arg name="odom_in" default="/odom"/>
  <arg name="scan_in" default="/velodyne_points"/>
  <arg name="cmd_in" default="/cmu_cmd_vel"/>
  <arg name="cmd_out" default="/cmd_vel"/>
  <arg name="state_estimation_out" default="/state_estimation"/>
  <arg name="registered_scan_out" default="/registered_scan"/>
  <arg name="laserscan_out" default="/scan"/>
  <arg name="map_frame" default="map"/>
  <arg name="base_frame" default="sensor"/>
  <arg name="scan_frame" default=""/>
  <arg name="publish_tf" default="true"/>
  <arg name="publish_laserscan" default="true"/>
  <arg name="transform_scan_to_map" default="true"/>
  <arg name="scan_offset_x" default="0.12"/>
  <arg name="scan_offset_y" default="0.0"/>
  <arg name="scan_offset_z" default="0.19"/>
  <arg name="laserscan_min_z" default="-0.2"/>
  <arg name="laserscan_max_z" default="1.0"/>
  <arg name="laserscan_angle_min" default="-3.14159265359"/>
  <arg name="laserscan_angle_max" default="3.14159265359"/>
  <arg name="laserscan_angle_increment" default="0.01745329252"/>
  <arg name="laserscan_range_min" default="0.3"/>
  <arg name="laserscan_range_max" default="40.0"/>
  <arg name="cmd_scale_linear" default="1.0"/>
  <arg name="cmd_scale_angular" default="1.0"/>
  <arg name="max_linear" default="0.8"/>
  <arg name="max_angular" default="1.2"/>

  <node pkg="a1_exploration_bridge" type="cmu_a1_bridge.py" name="cmu_a1_bridge" output="screen">
    <param name="state_source" value="$(arg state_source)"/>
    <param name="model_name" value="$(arg model_name)"/>
    <param name="odom_in" value="$(arg odom_in)"/>
    <param name="scan_in" value="$(arg scan_in)"/>
    <param name="cmd_in" value="$(arg cmd_in)"/>
    <param name="cmd_out" value="$(arg cmd_out)"/>
    <param name="state_estimation_out" value="$(arg state_estimation_out)"/>
    <param name="registered_scan_out" value="$(arg registered_scan_out)"/>
    <param name="laserscan_out" value="$(arg laserscan_out)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="scan_frame" value="$(arg scan_frame)"/>
    <param name="publish_tf" value="$(arg publish_tf)"/>
    <param name="publish_laserscan" value="$(arg publish_laserscan)"/>
    <param name="transform_scan_to_map" value="$(arg transform_scan_to_map)"/>
    <param name="scan_offset_x" value="$(arg scan_offset_x)"/>
    <param name="scan_offset_y" value="$(arg scan_offset_y)"/>
    <param name="scan_offset_z" value="$(arg scan_offset_z)"/>
    <param name="laserscan_min_z" value="$(arg laserscan_min_z)"/>
    <param name="laserscan_max_z" value="$(arg laserscan_max_z)"/>
    <param name="laserscan_angle_min" value="$(arg laserscan_angle_min)"/>
    <param name="laserscan_angle_max" value="$(arg laserscan_angle_max)"/>
    <param name="laserscan_angle_increment" value="$(arg laserscan_angle_increment)"/>
    <param name="laserscan_range_min" value="$(arg laserscan_range_min)"/>
    <param name="laserscan_range_max" value="$(arg laserscan_range_max)"/>
    <param name="cmd_scale_linear" value="$(arg cmd_scale_linear)"/>
    <param name="cmd_scale_angular" value="$(arg cmd_scale_angular)"/>
    <param name="max_linear" value="$(arg max_linear)"/>
    <param name="max_angular" value="$(arg max_angular)"/>
  </node>
</launch>
