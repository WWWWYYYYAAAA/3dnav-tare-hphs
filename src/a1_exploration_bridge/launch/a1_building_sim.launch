<launch>
  <arg name="rname" default="a1"/>
  <arg name="wname" default="Building"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>

  <env name="GAZEBO_MODEL_PATH" value="$(optenv GAZEBO_MODEL_PATH):$(find unitree_gazebo)/models"/>

  <include file="$(find unitree_guide)/launch/gazeboSim.launch">
    <arg name="rname" value="$(arg rname)"/>
    <arg name="wname" value="$(arg wname)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>
</launch>
